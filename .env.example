# ───────── Servidor local ─────────
PORT=3210
# De quanto em quanto tempo consultar o Gmail (segundos)
POLL_SECONDS=60

# ───────── Sua empresa (entra no prompt e na assinatura) ─────────
COMPANY_NAME=Minha Empresa
SIGNATURE=Equipe Minha Empresa
SIGNATURE_EN=Minha Empresa Team
# Pasta com as políticas (arquivos .md). Linhas com [INTERNO ...] nunca são enviadas ao modelo.
POLICIES_DIR=policies
# Termos (regex, separados por |) que NÃO podem aparecer na resposta ao cliente: levantam o risco para alto
LEAK_PATTERNS=al[cç]ada|\[INTERNO

# ───────── Gmail (cliente OAuth do tipo "App para computador" no SEU projeto Google Cloud) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────── Modelo (qualquer endpoint compatível com a API da OpenAI) ─────────
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4.1
# Vercel:      LLM_BASE_URL=https://ai-gateway.vercel.sh/v1  LLM_MODEL=openai/gpt-4.1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=<modelo local>  (LLM_API_KEY=qualquer valor)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1

# ───────── Pipedrive (somente leitura; opcional) ─────────
PIPEDRIVE_DOMAIN=
PIPEDRIVE_API_TOKEN=

# ───────── Só para `npm run eval` (endereços que existem no seu Pipedrive de teste) ─────────
DEMO_EMAIL_PADARIA=
DEMO_EMAIL_SYCODE=
DEMO_EMAIL_CREDENTIALHUB=
